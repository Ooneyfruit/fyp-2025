{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "cypress.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "commitlint.config.js",
    "stylelint.config.mjs"
