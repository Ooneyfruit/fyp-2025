# Run lint-staged to format and lint specific staged files.
npx lint-staged || exit 1

# Run Type Checks (Crucial for TypeScript)
npx vue-tsc -b || exit 1

# Check for unused files and exports.
npm run knip || exit 1

# Run the full test suite.
npm run test:run || exit 1

# Audit dependencies for critical-level vulnerabilities.
npm audit --audit-level=critical || exit 1

# Build the documentation using TypeDoc.
# This generates the HTML files in docs/gen.
npm run docs:build || exit 1

# Stage the generated documentation files.
# This ensures the updated docs are included in the commit.
git add docs/gen