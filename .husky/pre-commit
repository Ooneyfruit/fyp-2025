# 1. Run lint-staged to format and lint specific staged files.
npx lint-staged || exit 1

# 2. Run the full test suite.
npm run test:run || exit 1

# 3. Build the documentation using TypeDoc.
# This generates the HTML files in docs/gen.
npm run docs:build || exit 1

# 4. Check for unused files and exports.
npm run knip || exit 1

# 5. Audit dependencies for high-level vulnerabilities.
npm audit --audit-level=high || exit 1

# 6. Stage the generated documentation files.
# This ensures the updated docs are included in the commit.
git add docs/gen