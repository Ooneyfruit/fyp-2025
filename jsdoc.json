{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.(js|jsdoc|jsx|vue)$",
    "excludePattern": "(^|\\/|\\\\)node_modules"
  },
  "opts": {
    "destination": "./docs/gen",
    "recurse": true,
    "readme": "./README.md"
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "plugins": ["node_modules/jsdoc-vuejs"]
}
