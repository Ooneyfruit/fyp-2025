{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "project": ["src/**/*.{js,ts,vue}"],
  "ignore": [
    "node_modules/**",
    "docs/gen/**",
    "src/services/**",
    "src/components/icons/**",
    "src/views/HomeView.vue",
    "src/shimsVue.d.ts",
    "src/types/firebase.d.ts",
    "src/types/generic.ts",
    "src/features/users/userTypes.ts",
    "src/features/rota/rotaTypes.ts",
    "src/features/rota/composables/useRotaDates.ts",
    "GEMINI.md",
    ".gemini/config.yaml"
  ],
  "ignoreBinaries": [],
  "ignoreDependencies": ["@commitlint/cli", "firebase-admin"],
  "paths": {
    "@/*": ["src/*"]
  }
}
