  "dependencies": {
    "firebase": "^12.6.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "firebase-tools": "^15.0.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
