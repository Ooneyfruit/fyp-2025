{
  "name": "fyp-2025",
  "version": "1.0.0",
  "type": "module",
  "description": "Final Year Project 2025",
  "main": "src/main.ts",
  "scripts": {
    "start": "npm run dev",
    "test": "vitest --exclude src/test/firestore.rules.test.ts",
    "test:run": "vitest run --exclude src/test/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec \"vitest run src/test/firestore.rules.test.ts\"",
    "setup": "npm install && firebase login",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "lint:style:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "format": "prettier --write .",
    "spellcheck": "cspell \"**/*\"",
    "knip": "knip",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "prepare": "husky || true",
    "deploy": "npm run build && firebase deploy",
    "deploy:branch": "npm run build && firebase hosting:channel:deploy $(git branch --show-current) --expires 7d",
    "undeploy": "firebase hosting:disable -f",
    "undeploy:branch": "firebase hosting:channel:delete $(git branch --show-current) -f"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,vue}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{json,html,md}": [
      "prettier --write"
    ],
    "*": [
      "cspell --no-must-find-files"
    ]
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "firebase-admin": "^13.0.1",
    "vue": "^3.5.26",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.21",
    "@vue/test-utils": "^2.2.7",
    "@vue/tsconfig": "^0.8.1",
    "cspell": "^9.6.4",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.0.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "firebase-tools": "^13.6.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.3.4",
    "husky": "^9.1.7",
    "knip": "^5.41.0",
    "lint-staged": "^16.2.7",
    "postcss-html": "^1.7.0",
    "prettier": "^3.4.2",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-vue": "^1.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17",
    "vitest-mock-extended": "^3.1.0",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "minimatch": "10.2.4",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "@grpc/grpc-js": "^1.11.4",
    "protobufjs": "^7.2.5",
    "protobufjs-cli": "^2.5.7",
    "tar": "^7.5.7",
    "superstatic": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ooneyfruit/fyp-2025.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ooneyfruit/fyp-2025/issues"
  },
  "homepage": "https://github.com/Ooneyfruit/fyp-2025#readme"
}
