{
  "name": "fyp-2025",
  "version": "1.0.0",
  "type": "module",
  "description": "Final Year Project 2025",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "setup": "npm install && firebase login",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "lint:style:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "format": "prettier --write .",
    "spellcheck": "cspell \"**/*\"",
    "knip": "knip",
    "docs:build": "jsdoc -c jsdoc.json",
    "prepare": "husky",
    "deploy": "npm run build && firebase deploy",
    "deploy:branch": "npm run build && firebase hosting:channel:deploy $(git branch --show-current) --expires 7d",
    "undeploy": "firebase hosting:disable -f",
    "undeploy:branch": "firebase hosting:channel:delete $(git branch --show-current) -f"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,vue}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,html,md}": [
      "prettier --write"
    ],
    "*": [
      "cspell --no-must-find-files"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ooneyfruit/fyp-2025.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ooneyfruit/fyp-2025/issues"
  },
  "homepage": "https://github.com/Ooneyfruit/fyp-2025#readme",
  "overrides": {
    "diff": "^8.0.3"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "firebase-admin": "^13.0.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "cspell": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "firebase-tools": "^15.3.1",
    "globals": "^15.14.0",
    "happy-dom": "^20.3.4",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.4",
    "jsdoc-vuejs": "^4.0.0",
    "knip": "^5.41.0",
    "lint-staged": "^15.3.0",
    "postcss-html": "^1.7.0",
    "prettier": "^3.4.2",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^7.0.1",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.0.17"
  }
}
